<!DOCTYPE html>
<html lang="en">
<head>
  <style>
    .grid {
      display: grid;
      width: 600px;
      height: 350px;
      gap: 4px;
      background: #000;
      border: 4px solid #000;
      
      /* Visual layout map */
      grid-template-areas:
        "dark-red dark-red purple purple cyan   cyan"
        "dark-red dark-red blue   cream  cream  pink"
        "yellow   yellow   blue   cream  cream  pink"
        "yellow   yellow   red    red    grey   pink";
    }

    /* Assign div to grid area & color */
    .dark-red { grid-area: dark-red; background: #7a1c1c; }
    .yellow   { grid-area: yellow;   background: #eed037; }
    .purple   { grid-area: purple;   background: #8e52a1; }
    .cyan     { grid-area: cyan;     background: #5ebdcc; }
    .blue     { grid-area: blue;     background: #359bb8; }
    .cream    { grid-area: cream;    background: #e9dfb5; }
    .red      { grid-area: red;      background: #eb2f20; }
    .grey     { grid-area: grey;     background: #616666; }
    .pink     { grid-area: pink;     background: #e8a8b5; }
  </style>
</head>
<body>

  <div class="grid">
    <div class="dark-red"></div>
    <div class="yellow"></div>
    <div class="purple"></div>
    <div class="cyan"></div>
    <div class="blue"></div>
    <div class="cream"></div>
    <div class="red"></div>
    <div class="grey"></div>
    <div class="pink"></div>
  </div>

</body>
</html>
