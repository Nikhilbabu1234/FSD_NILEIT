<!DOCTYPE html>
<html>
<head>
    <title>Grid Layout</title>
    <link rel="stylesheet" href="style.css">
</head>
<body>

<div class="container">

    <div class="box b1"></div>
    <div class="box b2"></div>
    <div class="box b3"></div>
    <div class="box b4"></div>
    <div class="box b5"></div>
    <div class="box b6"></div>
    <div class="box b7"></div>
    <div class="box b8"></div>
    <div class="box b9"></div>

</div>

</body>
</html>







body{
    display: flex;
    justify-content: center;
}

.container{
    width: 900px;
    height: 370px;

    display: grid;

    grid-template-columns: 200px 100px 170px 120px 310px;
    grid-template-rows: 130px 120px 120px;

    border: 2px solid black;
}

.box{
    border: 2px solid black;
}

.b1{
    background: darkred;
    grid-row: 1 / 3;
}

.b2{
    background: violet;
    grid-column: 2 / 4;
}

.b3{
    background: lightblue;
    grid-column: 4 / 6;
}

.b4{
    background: yellow;
    grid-column: 1 / 2;
    grid-row: 3 / 4;
}

.b5{
    background: skyblue;
}

.b6{
    background: beige;
    grid-column: 3 / 5;
}

.b7{
    background: red;
    grid-column: 2 / 4;
}

.b8{
    background: gray;
}

.b9{
    background: pink;
    grid-column: 5 / 6;
    grid-row: 2 / 4;
}
